# Optional: override port when running the server
# PORT=8000

# FRED Treasury benchmarks (get_safe_yield_benchmarks). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Cache live benchmark responses (seconds). Default 21600 (6 hours).
# RATE_CACHE_TTL_SEC=21600

# Required for get_stock_quote (Finnhub). Free key: https://finnhub.io/register
# Copy this file to .env and set your key (python-dotenv loads .env on startup).
FINNHUB_API_KEY=
